# Server-side only. Never prefix these with NEXT_PUBLIC_.
#
# fixture: bundled sample responses, labelled as sample data (default outside Vercel; refused on Vercel Production)
# live:    signed reads of RDP via Vercel OIDC -> STS (Vercel Preview -> staging, Production -> production only)
RDP_DATA_MODE=fixture

# Live mode only. Set per Vercel environment; never store AWS access keys here.
# RDP_READ_API_URL=https://<api-id>.execute-api.eu-west-1.amazonaws.com/<staging|production>
# RDP_ROLE_ARN=arn:aws:iam::<account>:role/river-data-platform-<staging-ui-vercel-preview|production-ui-vercel-production>
# RDP_AWS_REGION=eu-west-1
